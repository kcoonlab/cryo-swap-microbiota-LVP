met_big <- left_join(met, ca2) %>% filter(sample_type == "adult") %>% mutate(biotype = paste0("biotype",data.cluster)) %>% filter(biotype != "biotypeNA") %>% filter(wing_length != "NA")
#Need to remove the 5 adult samples with <1042 reads, do this by fitlering out to just those that got assigned a biotype
met_big$wing_length <- as.numeric(met_big$wing_length)
# uni_tx counts
uni_tx_counts <- met_big %>%
group_by(biotype, uni_tx) %>%
summarise(n = n(), .groups = "drop") %>%
pivot_wider(
names_from = uni_tx,
values_from = n,
values_fill = 0
)
#UW match is overwhelmingly in biotype 1, LSTM-match is split almost perfeclty in half
#UW mismatch is also split almost perfeclry in half
#LSTM mismatch also split almost in half, but with 43 in biotype1 and 33 inbiotype 2. So really LSTM-match is the only one different between the two!
# timepoint counts
timepoint_biotype_counts <- met_big %>%
count(timepoint, biotype) %>%        # count samples per timepoint × biotype
pivot_wider(
names_from = biotype,
values_from = n,
values_fill = 0)
timepoint_biotype_counts
#interesting - seems liek the unfrozen timepoints really lean towrads biotype1,
wing_summary <- met_big %>%
group_by(biotype, uni_tx) %>%
summarise(
mean_wing_length = mean(wing_length, na.rm = TRUE),
sd_wing_length   = sd(wing_length, na.rm = TRUE),
n = n(),
.groups = "drop")
#oh, what if instead i made a boxplot of that
############### uni
plot_uni <- met_big %>%
ggplot+
geom_boxplot(outlier.shape = NA) +
aes(x=interaction(biotype,uni), y=wing_length, fill=biotype) +
#scale_fill_manual(values = c("#D0352B","#3C76B0", "#BBDE94"))+
#oord_cartesian(ylim=c(0,5)) + # adjust y-axis
xlab("Biotype") +
ylab("Wing Length")  +
theme_pubr() +
theme(axis.text.x = element_text(angle=90, vjust=0.5)) +
geom_jitter(width = 0.2, size=1.5) +
theme(legend.position="none") #+  #remove the legend as it isn't needed
# ggtitle("UW homogenate comparisons")
plot_uni
#ok, so it really doesn't seem like biotype1 or biotype2 dictates wing length - but how does match/mismatch interact with that?
LSTM_wings <- filter(met_big, uni == "LSTM")
ggqqplot(LSTM_wings$wing_length) #tbh not bad
t.test(wing_length~biotype,LSTM_wings, var.equal=FALSE) #nope
UW_wings <- filter(met_big, uni == "UW")
ggqqplot(UW_wings$wing_length) #tbh not bad
t.test(wing_length~biotype,UW_wings, var.equal=FALSE) #nope
############### uni_tx
plot <- met_big %>%
ggplot+
geom_boxplot(outlier.shape = NA) +
aes(x=interaction(biotype,uni_tx), y=wing_length, fill=biotype) +
#scale_fill_manual(values = c("#D0352B","#3C76B0", "#BBDE94"))+
#oord_cartesian(ylim=c(0,5)) + # adjust y-axis
xlab("Biotype") +
ylab("Wing Length")  +
theme_pubr() +
facet_wrap(~uni, scales = "free_x")+
theme(axis.text.x = element_text(angle=90, vjust=0.5)) +
geom_jitter(width = 0.2, size=1.5) +
theme(legend.position="none") #+  #remove the legend as it isn't needed
# ggtitle("UW homogenate comparisons")
plot
#intersting - some tiny trends could potentially bebigger biotype1 in LSTM-match and bigger UW-mismatch and LSTm-mismatch in biotype 2? Test each separately.
UWMis_wings <- filter(met_big, uni_tx == "UW-mismatch")
ggqqplot(UWMis_wings$wing_length) #tbh not bad
t.test(wing_length~biotype,UWMis_wings, var.equal=FALSE) #0.051 NS
LSTMmis_wings <- filter(met_big, uni_tx == "LSTM-mismatch")
ggqqplot(LSTMmis_wings$wing_length) #tbh not bad
t.test(wing_length~biotype,LSTMmis_wings, var.equal=FALSE) #0.1033 NS
LSTMM_wings <- filter(met_big, uni_tx == "LSTM-match")
ggqqplot(LSTMM_wings$wing_length) #tbh not bad
t.test(wing_length~biotype,LSTMM_wings, var.equal=FALSE) #0.029 #techinicall significant - but do i need to adjust for doing 3 comparisons? point is, none of these are partiucarly strong comparisons
